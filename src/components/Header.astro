---
import { SITE_TITLE } from '../consts';
---

<header>
	<a href="/">{SITE_TITLE}</a>
</header>
<style>
	header {
		padding: 1.2rem 0;
		max-width: 720px;
		margin: 0 auto;
		padding-left: 1em;
		padding-right: 1em;
	}
	a {
		font-size: 0.9rem;
		font-weight: 600;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		letter-spacing: 0.02em;
	}
	a:hover {
		color: var(--accent);
	}
</style>
