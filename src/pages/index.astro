---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const tech = (await getCollection('tech')).map((p) => ({ ...p, category: 'tech' }));
const blog = (await getCollection('blog')).map((p) => ({ ...p, category: 'blog' }));
const posts = [...tech, ...blog].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			nav.tabs {
				display: flex;
				gap: 1.5rem;
				margin-bottom: 1.5rem;
				font-size: 0.9rem;
			}
			nav.tabs a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			nav.tabs a:hover,
			nav.tabs a.active {
				color: rgb(var(--gray-dark));
			}
			nav.tabs a.active {
				border-bottom: 2px solid var(--accent);
			}
			ul {
				display: flex;
				flex-direction: column;
				gap: 0;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			ul li:first-child {
				border-top: 1px solid rgb(var(--gray-light));
			}
			ul li a {
				display: flex;
				align-items: baseline;
				gap: 1.2rem;
				padding: 1rem 0.25rem;
				text-decoration: none;
				transition: background 0.15s ease;
			}
			ul li a:hover {
				background: rgba(var(--gray-light), 0.4);
			}
			.title {
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 1rem;
				font-weight: 600;
				line-height: 1.4;
				flex: 1;
			}
			ul li a:hover .title {
				color: var(--accent);
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.85rem;
				white-space: nowrap;
				min-width: 7.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<nav class="tabs">
				<a href="/" class="active">All</a>
				<a href="/tech">Tech</a>
				<a href="/blog">Blog</a>
			</nav>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/article/${post.category}/${post.id}/`}>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<h4 class="title">{post.data.title}</h4>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
